{
  "name": "@knkcs/fieldkit",
  "version": "0.18.0-rc.3",
  "description": "Specification-driven field system for defining, rendering, and tabulating structured data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knkCS/fieldkit.git"
  },
  "type": "module",
  "main": "./dist/schema/index.js",
  "types": "./dist/schema/index.d.ts",
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "default": "./dist/renderer/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js",
      "default": "./dist/table/index.js"
    },
    "./rich-text-spec": {
      "types": "./dist/rich-text-spec/index.d.ts",
      "import": "./dist/rich-text-spec/index.js",
      "default": "./dist/rich-text-spec/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "import": "./dist/publishing/index.js",
      "default": "./dist/publishing/index.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text/index.d.ts",
      "import": "./dist/rich-text/index.js",
      "default": "./dist/rich-text/index.js"
    },
    "./catalogue.json": "./go/catalogue.json",
    "./publishing/catalogue.json": "./go/publishing/catalogue.json"
  },
  "files": [
    "dist",
    "go/catalogue.json",
    "go/publishing/catalogue.json"
  ],
  "scripts": {
    "dev": "storybook dev -p 6007",
    "build": "tsup",
    "build:storybook": "storybook build",
    "lint": "biome check src",
    "lint:write": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-exports": "tsx scripts/verify-exports.ts",
    "verify-peers": "tsx scripts/verify-peers.ts",
    "test:gate": "vitest run --testTimeout=30000 --retry=1",
    "catalogue": "tsx scripts/catalogue.ts",
    "catalogue:check": "tsx scripts/catalogue.ts --check",
    "catalogue:compat": "tsx scripts/catalogue-compat.ts",
    "release": "tsx scripts/release.ts",
    "verify:go": "bash scripts/verify-go.sh",
    "verify:full": "FIELDKIT_FUZZTIME=60s npm run verify",
    "verify": "npm run lint && npm run typecheck && npm run catalogue:check && npm run catalogue:compat && npm run build && npm run verify-exports && npm run verify-peers && npm run test:gate && npm run verify:go",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.0.0",
    "@knkcms/knkeditor-editor": "^1.8.0",
    "@knkcms/knkeditor-vocabulary": "^0.1.0",
    "@knkcs/anker": "^5.5.0",
    "@tanstack/react-table": "^8.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@knkcms/knkeditor-editor": {
      "optional": true
    },
    "@knkcms/knkeditor-vocabulary": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@chakra-ui/react": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^3.9.0",
    "@knkcms/knkeditor-editor": "^1.8.0",
    "@knkcms/knkeditor-vocabulary": "^0.1.0",
    "@knkcs/anker": "^5.5.0",
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/react-vite": "^8.4.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
