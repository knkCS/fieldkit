						"children": [
							{
								"_id": "n3",
								"values": {
									"title": "One.One.One"
								}
							}
						]
					}
				]
			},
			{
				"_id": "n4",
				"values": {
					"title": "Two"
				}
			}
		],
		"draft": [
			{
				"_id": "d1",
				"values": {
					"anything": [
						1,
						2
					]
				},
				"children": [
					{
						"_id": "d2"
					}
				]
			}
		]
	},
	"expect": {
		"validateValue": []
	}
