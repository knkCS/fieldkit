					"system": false
				},
				{
					"field_type": "number",
					"config": {
						"name": "Number",
						"api_accessor": "number",
						"required": false,
						"instructions": ""
					},
					"system": false
				}
			],
			"system": false
		},
		{
			"field_type": "outline_tree",
			"config": {
				"name": "Draft",
				"api_accessor": "draft",
				"required": false,
				"instructions": ""
			},
			"settings": {
				"blueprint": "outline-bp@1"
			},
			"system": false
		}
	],
	"data": {
		"outline": [
			{
				"_id": "n1",
				"values": {
					"kind": "part",
					"title": "One"
				},
				"children": [
					{
						"_id": "n2",
						"values": {
							"kind": "chapter",
							"title": "One.One",
							"number": 1
