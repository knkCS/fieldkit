			},
			"children": [
				{
					"field_type": "select",
					"config": {
						"name": "Kind",
						"api_accessor": "kind",
						"required": false,
						"instructions": ""
					},
					"settings": {
						"options": {
							"part": "Part",
							"chapter": "Chapter"
						}
					},
					"system": false
				},
				{
